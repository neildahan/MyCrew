# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key

# WhatsApp Business API (Meta)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_VERIFY_TOKEN=your_verify_token
WHATSAPP_APP_SECRET=your_app_secret

# The two crew members, comma-separated, in WhatsApp format (no +).
# Used by the morning digest, and the basis for a sender allowlist.
CREW_WHATSAPP_NUMBERS=972500000000,972510000000
# Optional, positional, matches the numbers above. Used for readable output.
CREW_NAMES=Neil,Inbal

# Local hour (Asia/Jerusalem) for the morning digest. Defaults to 8.
DIGEST_HOUR=8

# Cron Secret (protect scheduled task endpoint)
CRON_SECRET=your_cron_secret

# Soft monthly spend cap in USD, enforced against usage_logs.
# At 80% the assistant downgrades to a cheaper model; at 100% it stops.
# Set a hard limit in the Anthropic Console too - this one only sees spend
# that this app recorded.
MONTHLY_BUDGET_USD=10

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_key

# Optional: Future AI providers
# OPENAI_API_KEY=your_openai_key

# Microsoft / Outlook calendar (Microsoft Graph, read-only)
# Azure app registration -> redirect URI must match MICROSOFT_REDIRECT_URI.
# Scope used is Calendars.ReadBasic: subject/time/location but NOT event bodies.
MICROSOFT_CLIENT_ID=your_azure_app_client_id
MICROSOFT_CLIENT_SECRET=your_azure_app_client_secret
MICROSOFT_REDIRECT_URI=https://mycrew-app.vercel.app/api/auth/callback/microsoft
# "common" allows work and personal accounts; set a tenant id to restrict.
MICROSOFT_TENANT=common
