{
  "functions": {
    "src/app/api/webhooks/whatsapp/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "0 5,6 * * *"
    }
  ]
}
